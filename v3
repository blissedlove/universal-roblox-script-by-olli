local function showVisuals()
    clearContent()
    section("VISUALS")
    toggle("2D bounding boxes", "BoxESP")
    toggle("Skeleton lines", "SkeletonESP")
    toggle("Bottom-screen tracers", "Tracers")
    section("Overlays are rendered locally for your own experience.")
end

local function showConfig()
    clearContent()
    section("CONFIG")
    actionButton("Save current settings", function()
        -- Session-only storage. LocalScripts cannot write arbitrary files.
        for key, value in pairs(Config) do
            gui:SetAttribute("Saved_" .. key, value)
        end
    end)
    actionButton("Load saved settings", function()
        for key in pairs(CONFIG_DEFAULTS) do
            local value = gui:GetAttribute("Saved_" .. key)
            if value ~= nil then Config[key] = value end
        end
        showConfig()
    end)
    actionButton("Reset defaults", function()
        Config = table.clone(CONFIG_DEFAULTS)
        showConfig()
    end)
    section("This saves for the current play session only.")
    section("Cross-session saving requires a server DataStore.")
end

local function unload()
    if Unloaded then return end
    Unloaded = true
    disconnectAll()
    for _, visual in pairs(PlayerVisuals) do
        if visual.Folder then visual.Folder:Destroy() end
    end
    table.clear(PlayerVisuals)
    if silentAimProvider then
        silentAimProvider:Destroy()
    end
    gui:Destroy()
    overlayGui:Destroy()
end

local function showMisc()
    clearContent()
    section("MISC")
    actionButton("Unload toolkit", unload)
    section("Removes the interface and disconnects its event handlers.")
end

makeTab("Combat", showCombat)
makeTab("Visuals", showVisuals)
makeTab("Config", showConfig)
makeTab("Misc", showMisc)

connect(closeButton.Activated, function()
    main.Visible = false
end)

connect(UserInputService.InputBegan, function(input, processed)
    if Unloaded then return end

    if WaitingForAimBind and input.UserInputType == Enum.UserInputType.Keyboard then
        Config.AimBind = input.KeyCode
        WaitingForAimBind = false
        showCombat()
        return
    end

    if input.KeyCode == Enum.KeyCode.RightControl and not processed then
        main.Visible = not main.Visible
        return
    end

    if input.KeyCode == Config.AimBind and not processed then
        AimKeyHeld = true
        if Config.AimMode == "Toggle" then
            AimToggleActive = not AimToggleActive
        end
    end
end)

connect(UserInputService.InputEnded, function(input)
    if input.KeyCode == Config.AimBind then
        AimKeyHeld = false
    end
end)

connect(RunService.RenderStepped, function(deltaTime)
    if Unloaded then return end
    Camera = workspace.CurrentCamera or Camera

    local viewport = Camera.ViewportSize
    fovCircle.Position = UDim2.fromOffset(viewport.X / 2, viewport.Y / 2)
    fovCircle.Size = UDim2.fromOffset(Config.FOV * 2, Config.FOV * 2)
    fovCircle.Visible = Config.AimEnabled

    for player, visual in pairs(PlayerVisuals) do
        updateVisual(player, visual)
    end

    local activationRequested = (Config.AimMode == "Hold" and AimKeyHeld)
        or (Config.AimMode == "Toggle" and AimToggleActive)
    local aimbotActive = Config.AimEnabled and activationRequested
    local target = (aimbotActive or Config.SilentAimEnabled) and findTarget() or nil

    CurrentTarget = target
    SilentAimTarget = target

    if aimbotActive and CurrentTarget then
        local cameraPosition = Camera.CFrame.Position
        local desired = CFrame.lookAt(cameraPosition, CurrentTarget.Position)
        local alpha = 1 / math.max(Config.Smoothness, 1)
        Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(alpha, 0.01, 1))
    end
end)

showCombat()
