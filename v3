local function newLine(parent)
    return make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(0, 190, 255),
        BorderSizePixel = 0,
        Visible = false,
    }, parent)
end

local function setLine(line, a, b, thickness)
    local delta = b - a
    line.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    line.Size = UDim2.fromOffset(delta.Magnitude, thickness or 2)
    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    line.Visible = true
end

local function makeVisuals(player)
    local folder = make("Folder", {Name = "P" .. player.UserId}, overlayGui)
    local box = make("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
    }, folder)
    make("UIStroke", {
        Color = Color3.fromRGB(0, 190, 255),
        Thickness = 1.5,
    }, box)

    local tracer = newLine(folder)
    local skeletonLines = {}
    for i = 1, 15 do
        skeletonLines[i] = newLine(folder)
    end

    PlayerVisuals[player] = {
        Folder = folder,
        Box = box,
        Tracer = tracer,
        Skeleton = skeletonLines,
    }
end

local RIG_LINKS = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"},
}
local R6_LINKS = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function projectPart(character, partName)
    local part = character and character:FindFirstChild(partName)
    if not part or not part:IsA("BasePart") then return nil end
    local p, visible = Camera:WorldToViewportPoint(part.Position)
    if not visible or p.Z <= 0 then return nil end
    return Vector2.new(p.X, p.Y)
end

local function updateVisual(player, visual)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid or humanoid.Health <= 0 then
        visual.Box.Visible = false
        visual.Tracer.Visible = false
        for _, line in ipairs(visual.Skeleton) do line.Visible = false end
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if Config.BoxESP then
        local cf, size = character:GetBoundingBox()
        local corners = {}
        for x = -1, 1, 2 do
            for y = -1, 1, 2 do
                for z = -1, 1, 2 do
                    local world = (cf * CFrame.new(
                        size.X * x / 2, size.Y * y / 2, size.Z * z / 2
                    )).Position
                    local p, onScreen = Camera:WorldToViewportPoint(world)
                    if onScreen and p.Z > 0 then
                        table.insert(corners, Vector2.new(p.X, p.Y))
                    end
                end
            end
        end
        if #corners >= 4 then
            local minX, minY = math.huge, math.huge
            local maxX, maxY = -math.huge, -math.huge
            for _, p in ipairs(corners) do
                minX, minY = math.min(minX, p.X), math.min(minY, p.Y)
                maxX, maxY = math.max(maxX, p.X), math.max(maxY, p.Y)
            end
            visual.Box.Position = UDim2.fromOffset(minX, minY)
            visual.Box.Size = UDim2.fromOffset(maxX - minX, maxY - minY)
            visual.Box.Visible = true
        else
            visual.Box.Visible = false
        end
    else
        visual.Box.Visible = false
    end

    if Config.Tracers then
        local p, visible = Camera:WorldToViewportPoint(root.Position)
        if visible and p.Z > 0 then
            local from = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            setLine(visual.Tracer, from, Vector2.new(p.X, p.Y), 2)
        else
            visual.Tracer.Visible = false
        end
    else
        visual.Tracer.Visible = false
    end

    if Config.SkeletonESP then
        local links = character:FindFirstChild("UpperTorso") and RIG_LINKS or R6_LINKS
        for index, link in ipairs(links) do
            local a = projectPart(character, link[1])
            local b = projectPart(character, link[2])
            local line = visual.Skeleton[index]
            if a and b and line then
                setLine(line, a, b, 2)
            elseif line then
                line.Visible = false
            end
        end
        for index = #links + 1, #visual.Skeleton do
            visual.Skeleton[index].Visible = false
        end
    else
        for _, line in ipairs(visual.Skeleton) do line.Visible = false end
    end
end

local function addPlayer(player)
    if player ~= LocalPlayer and not PlayerVisuals[player] then
        makeVisuals(player)
    end
end

for _, player in ipairs(Players:GetPlayers()) do addPlayer(player) end
