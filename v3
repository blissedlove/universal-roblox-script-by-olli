    slider("Aim FOV radius", "FOV", 25, 500, 5)

    section("AIMBOT ACTIVATION")
    actionButton("Activation mode: " .. Config.AimMode, function()
        Config.AimMode = Config.AimMode == "Toggle" and "Hold" or "Toggle"
        showCombat()
    end)
    actionButton("Aimbot bind: " .. Config.AimBind.Name .. " (click to rebind)", function()
        WaitingForAimBind = true
        showCombat()
        section("Press any keyboard key to assign the aimbot bind.")
    end)

    section("SILENT AIM")
    toggle("Silent Aim (own-game weapon integration)", "SilentAimEnabled")
